# Tripelyx — environment template. Copy to .env for local development.
# PLACEHOLDERS ONLY. Never commit real values; set them in each environment's secret store.
# Development, staging and production each get their OWN database and credentials.

# --- Environment -------------------------------------------------------------
# development | staging | production
APP_ENV=development
PORT=4100
PUBLIC_BASE_URL=http://localhost:4100
# Set to true only behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false
CONTACT_EMAIL=hello@example.com
# Where the "Alamein Go" brand card links to.
ALAMEIN_GO_URL=/book/hotels?where=New+Alamein

# --- Database ----------------------------------------------------------------
# Optional in development (in-memory store when empty). Required in staging and production.
# Use a separate database and user per environment, e.g.
#   development: postgres://tripelyx_dev:<password>@localhost:5432/tripelyx_dev
#   staging:     postgres://tripelyx_staging:<password>@<staging-host>:5432/tripelyx_staging
#   production:  postgres://tripelyx_prod:<password>@<production-host>:5432/tripelyx_prod
DATABASE_URL=
# Must equal APP_ENV; the app refuses to boot if a URL from another environment is used.
DATABASE_ENV=development
# Defaults to true outside development.
DATABASE_SSL=false

# --- Verticals (feature flags) ----------------------------------------------
# Default: on outside production, off in production until switched on explicitly.
ENABLE_HOTELS=true
ENABLE_FLIGHTS=true
ENABLE_CARS=true
ENABLE_CRUISES=true
ENABLE_YACHTS=true
ENABLE_TRANSFERS=true
ENABLE_ACTIVITIES=true
ENABLE_EXPERIENCES=true

# --- Providers ---------------------------------------------------------------
# "mock" = isolated demo inventory. Real adapters are registered in server/providers/adapters/index.js
# and selected here by name (e.g. HOTEL_PROVIDER=<adapter-name>). Their credentials go in
# variables the adapter reads server-side, e.g. HOTEL_PROVIDER_API_KEY=<placeholder>.
HOTEL_PROVIDER=mock
FLIGHT_PROVIDER=mock
CAR_PROVIDER=mock
CRUISE_PROVIDER=mock
YACHT_PROVIDER=mock
TRANSFER_PROVIDER=mock
ACTIVITY_PROVIDER=mock
EXPERIENCE_PROVIDER=mock
# Demo inventory is refused in production unless this is true (e.g. a public sales demo with PAYMENT_MODE=test).
ALLOW_DEMO_INVENTORY=true
# Simulated supplier latency for mock providers (ms).
MOCK_LATENCY_MS=0

# --- Payments ----------------------------------------------------------------
# test = test processor, no real charges, test cards only.
# live = real charges; only allowed with APP_ENV=production, a registered processor, both secrets
# below, and ALLOW_DEMO_INVENTORY=false. Live processors live in server/payments/live/index.js.
PAYMENT_MODE=test
PAYMENT_CURRENCY=USD
PAYMENT_LIVE_PROCESSOR=
PAYMENT_LIVE_SECRET_KEY=
PAYMENT_LIVE_WEBHOOK_SECRET=

# --- Booking windows ---------------------------------------------------------
QUOTE_TTL_MINUTES=20
PAYMENT_WINDOW_MINUTES=20
