# Tripelyx — environment template. Copy to .env for local development.
# PLACEHOLDERS ONLY. Never commit real values; set them in each environment's secret store.
# Development, staging and production each get their OWN database and credentials.

# --- Environment -------------------------------------------------------------
# development | staging | production
APP_ENV=development
PORT=4100
PUBLIC_BASE_URL=http://localhost:4100
# Set to true only behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false
# HSTS, upgrade-insecure-requests and Secure cookies. Defaults to true outside development; set false
# only for a staging site served over plain http (production refuses false).
HTTPS_ONLY=
CONTACT_EMAIL=hello@example.com
# Where the "Alamein Go" brand card links to.
ALAMEIN_GO_URL=/book/hotels?where=New+Alamein

# --- Database ----------------------------------------------------------------
# Optional in development (in-memory store when empty). Required in staging and production.
# DATABASE_URL=memory runs a throwaway staging demo on the in-memory store (refused in production).
# Use a separate database and user per environment, e.g.
#   development: postgres://tripelyx_dev:<password>@localhost:5432/tripelyx_dev
#   staging:     postgres://tripelyx_staging:<password>@<staging-host>:5432/tripelyx_staging
#   production:  postgres://tripelyx_prod:<password>@<production-host>:5432/tripelyx_prod
DATABASE_URL=
# Alternatively give the parts separately (used on AWS, where the password comes from Secrets Manager):
# DATABASE_HOST= DATABASE_PORT=5432 DATABASE_NAME= DATABASE_USER= DATABASE_PASSWORD=
# CA bundle file for the database's TLS certificate (the Docker image ships Amazon RDS's bundle).
DATABASE_SSL_CA_FILE=
# Must equal APP_ENV; the app refuses to boot if a URL from another environment is used.
DATABASE_ENV=development
# Defaults to true outside development.
DATABASE_SSL=false

# --- Verticals (feature flags) ----------------------------------------------
# Default: on outside production, off in production until switched on explicitly.
ENABLE_HOTELS=true
ENABLE_FLIGHTS=true
ENABLE_CARS=true
ENABLE_CRUISES=true
ENABLE_YACHTS=true
ENABLE_TRANSFERS=true
ENABLE_ACTIVITIES=true
ENABLE_EXPERIENCES=true

# --- Travel by Budget --------------------------------------------------------
# The budget-first trip planner (homepage, /plan, /trip, accounts, /admin). Default: on outside
# production, off in production until switched on explicitly. With it off, "/" is the corporate site.
ENABLE_TRIPS=true
# Trip integrations: "mock" = invented demo inventory (refused where ALLOW_DEMO_INVENTORY=false).
# Real adapters are registered in server/trips/integrations/index.js and selected here by name; their
# credentials go in variables the adapter reads server-side, e.g. TRIP_FLIGHTS_PROVIDER_API_KEY=<placeholder>.
TRIP_MAPS_PROVIDER=mock
TRIP_WEATHER_PROVIDER=mock
TRIP_FLIGHTS_PROVIDER=mock
TRIP_HOTELS_PROVIDER=mock
TRIP_ACTIVITIES_PROVIDER=mock
TRIP_TRANSFERS_PROVIDER=mock
TRIP_GUIDES_PROVIDER=mock
# "outbox" records every email/SMS the platform would send (visible under /admin/outbox) without
# sending it. Register a real provider in server/trips/integrations/notifications.js and name it here.
NOTIFY_PROVIDER=outbox
# Comma-separated emails of the accounts allowed into the admin control center (/admin and /admin/business).
# Being listed is half of it: the account also needs an active platform_admin record. The first boot grants
# one once to the listed accounts created before 2026-10-08 (the one-time grandfather seed); anyone else is
# granted with: node scripts/platform-admin.js grant --email <address> (list, grant, revoke; see README).
ADMIN_EMAILS=
# AI Savings Hunter: minutes between scheduled re-runs of every active hunt while the site runs (hunts
# also run each time they are opened). 0 turns the scheduler off; the pages then say hunts run only
# when opened. Default 360 (6 hours).
HUNT_INTERVAL_MINUTES=360

# --- Tripelyx Business --------------------------------------------------------
# Tripelyx Business: company travel workspaces (policy, approvals, budgets) under /business. Off unless
# set; set true locally to preview. No emails are sent; invites are copy links. Admins: ADMIN_EMAILS is the
# allow-list, and a platform_admin record is also required (see scripts/platform-admin.js).
# Works with ENABLE_TRIPS on or off. With it off, every other page is exactly as it was before Business.
# To click through it with demo companies on your computer (in-memory store, every role, test scenarios):
#   APP_ENV=development node scripts/business-demo.js --port 4400 --production-preview 4401
ENABLE_BUSINESS=false
# false: a new company waits for a platform admin to confirm it at /admin/business before teammates can join.
BUSINESS_SELF_SERVE=false
# Days an invite link stays usable.
BUSINESS_INVITE_DAYS=7
# Companies one account can create or join.
BUSINESS_MAX_ORGS_PER_USER=3
# Hours a request waits for a decision before it expires (the default for new companies; each company picks 4 to 168).
BUSINESS_APPROVAL_HOURS=24
# Business has its own rate limits (not the shared 40-per-10-minute form limit), counted per running task:
# workspace writes per user per 10 minutes, searches and decisions per user per minute, and sign-up and
# sign-in attempts per IP per 10 minutes (sign-in is also limited to 10 per email address per 15 minutes).
BUSINESS_WRITE_LIMIT=300
BUSINESS_COMPUTE_LIMIT=30
BUSINESS_AUTH_LIMIT=20
# What writes the notes beside cheaper alternatives. Only "rules" exists: rule-based, no AI model is
# connected and no trip data leaves Tripelyx. Anything else fails at boot.
BUSINESS_EXPLAINER=rules
# Real flight and hotel suppliers for Business (round 1: the suppliers' test systems only). Business only:
# /book and the rest of the site never use them. Keys come only from the environment: GitHub secrets for
# CI, AWS Secrets Manager for the preview stack; never a file in the repo. A bad or missing setting never
# stops the app: the suppliers switch off, Business says "Supplier not connected yet", and /admin/business
# names the variable to fix (never its value). Prices from a test system are labelled "Supplier test data"
# with a TEST DATA tag on every amount; nothing is booked or charged.
# Flight supplier: empty (off) or duffel. Round 1 accepts only a Duffel test token (it starts duffel_test_).
BUSINESS_FLIGHT_SUPPLIER=
DUFFEL_ACCESS_TOKEN=
# Hotel supplier: empty (off) or liteapi, and only with a working flight supplier. Round 1 accepts only a
# LiteAPI sandbox key (it starts sand_). Without one, hotels say "Hotels are not connected yet" (never demo hotels).
BUSINESS_HOTEL_SUPPLIER=
LITEAPI_API_KEY=
# Supplier test data must be switched on by hand on every deployed stack, staging included. Empty means
# true in development and false everywhere else.
BUSINESS_ALLOW_SUPPLIER_TEST=
# The hotel guest's nationality sent to the hotel supplier (ISO 3166 two-letter code).
BUSINESS_GUEST_NATIONALITY=US
# Seconds a supplier's answer is reused for the same company and search (0 to 900).
BUSINESS_SUPPLIER_CACHE_SECONDS=300
# Supplier calls per company per hour (at most 20 in any one minute). Like the other Business limits, the
# counters and the result cache live in memory per running task: a restart resets them.
BUSINESS_SUPPLIER_COMPANY_CALLS_PER_HOUR=120
# Searches the cheaper-alternatives step may spend with a real supplier per trip (demo data keeps 20).
BUSINESS_SUPPLIER_VARIANT_SEARCHES=4

# --- Providers ---------------------------------------------------------------
# "mock" = isolated demo inventory. Real adapters are registered in server/providers/adapters/index.js
# and selected here by name (e.g. HOTEL_PROVIDER=<adapter-name>). Their credentials go in
# variables the adapter reads server-side, e.g. HOTEL_PROVIDER_API_KEY=<placeholder>.
HOTEL_PROVIDER=mock
FLIGHT_PROVIDER=mock
CAR_PROVIDER=mock
CRUISE_PROVIDER=mock
YACHT_PROVIDER=mock
TRANSFER_PROVIDER=mock
ACTIVITY_PROVIDER=mock
EXPERIENCE_PROVIDER=mock
# Demo inventory is refused in production unless this is true (e.g. a public sales demo with PAYMENT_MODE=test).
ALLOW_DEMO_INVENTORY=true
# Simulated supplier latency for mock providers (ms).
MOCK_LATENCY_MS=0

# --- Payments ----------------------------------------------------------------
# test = test processor, no real charges, test cards only.
# live = real charges; only allowed with APP_ENV=production, a registered processor, both secrets
# below, and ALLOW_DEMO_INVENTORY=false. Live processors live in server/payments/live/index.js.
PAYMENT_MODE=test
PAYMENT_CURRENCY=USD
PAYMENT_LIVE_PROCESSOR=
PAYMENT_LIVE_SECRET_KEY=
PAYMENT_LIVE_WEBHOOK_SECRET=

# --- Booking windows ---------------------------------------------------------
QUOTE_TTL_MINUTES=20
PAYMENT_WINDOW_MINUTES=20

# --- Private preview (infra/preview.yaml, README "Private preview") -----------
# PREVIEW_PASSWORD puts a password on every page but /healthz (HTTP Basic auth, any user name; at least 12
# characters). PREVIEW_SEED=business adds the Business demo companies at start-up (in-memory store and
# ENABLE_BUSINESS=true only). Both are refused when APP_ENV=production. Leave empty for a normal site.
PREVIEW_PASSWORD=
PREVIEW_SEED=
